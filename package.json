{
  "name": "@protolabsai/protopatch",
  "version": "0.5.0",
  "description": "Automated code review that lands fixes — protoLabs fork of clawpatch with a `gateway` provider for OpenAI-compatible endpoints.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protoLabsAI/protoPatch.git"
  },
  "homepage": "https://github.com/protoLabsAI/protoPatch#readme",
  "bugs": {
    "url": "https://github.com/protoLabsAI/protoPatch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "clawpatch": "dist/cli.js",
    "protopatch": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm -s build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint . --config oxlint.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "website:smoke": "node scripts/website-smoke.mjs",
    "test": "vitest run",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "check:changed": "pnpm run test",
    "test:changed": "pnpm run test",
    "crabbox:hydrate": "crabbox actions hydrate",
    "crabbox:run": "crabbox run",
    "crabbox:stop": "crabbox stop",
    "crabbox:warmup": "crabbox warmup"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2"
}
